{
  "name": "mindmap-editor",
  "version": "1.5.0",
  "description": "Edit a note as a mind map: headings and lists become nodes, with clickable checkboxes for tasks.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "preversion": "npm run release:check",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint styles.css --max-warnings=0",
    "review:obsidian": "npm outdated eslint-plugin-obsidianmd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node test/e2e/run.mjs",
    "check": "npm run build && npm run lint && npm run format:check && npm test",
    "release:check": "npm run review:obsidian && npm run check"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "^61.7.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.1",
    "obsidian": "^1.13.1",
    "prettier": "3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-obsidianmd": "^0.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "3.2.7"
  }
}
