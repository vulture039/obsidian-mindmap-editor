# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# The dev vault is committed for its fixtures and its hot-reload marker; the
# plugin build that lands in it, and Obsidian's per-machine state, are not.
dev-vault/.obsidian/plugins/mindmap-editor/main.js
dev-vault/.obsidian/plugins/mindmap-editor/manifest.json
dev-vault/.obsidian/plugins/mindmap-editor/styles.css
dev-vault/.obsidian/plugins/mindmap-editor/data.json
dev-vault/.obsidian/plugins/hot-reload
dev-vault/.obsidian/appearance.json
dev-vault/.obsidian/hotkeys.json
dev-vault/.obsidian/workspace*.json
dev-vault/.obsidian/cache
dev-vault/.trash

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Claude Code local settings
.claude/settings.local.json
